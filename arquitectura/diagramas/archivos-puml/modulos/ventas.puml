@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Diagrama de Componentes (Nivel 3) - Odoo 18 Módulo de Ventas

Container_Boundary(sales_app, "Módulo de Ventas (Contenedor Python)") {
    
    Component(sale_controller, "Controlador Web de Ventas", "Controlador Python", "Recibe las peticiones HTTP del usuario (crear orden, confirmar)")
    
    Component(sale_order, "Modelo: Sale.Order", "ORM Python", "Representa la cabecera de la Orden de Venta. Gestiona el estado (Borrador -> Confirmado)")
    
    Component(sale_order_line, "Modelo: Sale.Order.Line", "ORM Python", "Representa el detalle de los productos a vender y sus cantidades")
    
    Component(action_confirm, "Servicio: action_confirm()", "Método Python", "Lógica de negocio que aprueba la venta y detona la comunicación externa")
    
    Rel(sale_controller, sale_order, "Llama métodos CRUD en")
    Rel(sale_order, sale_order_line, "Contiene 1..N")
    Rel(sale_order, action_confirm, "Ejecuta al confirmar")
}

Container_Boundary(inv_app, "Módulo de Inventario (Contenedor Python)") {
    Component(stock_picking, "Modelo: Stock.Picking", "ORM Python", "Representa la orden de salida (Albarán) para el almacenero")
    Component(stock_move, "Modelo: Stock.Move", "ORM Python", "Representa la reserva física de una cantidad específica en el almacén")
}

ContainerDb(db, "Base de Datos Core", "PostgreSQL", "Almacena los registros relacionales")

' Relaciones Inter-componentes (El corazón del ERP)
Rel(action_confirm, stock_picking, "Crea automáticamente orden de salida vía API interna")
Rel(sale_order_line, stock_move, "Genera la reserva de mercancía por cada línea de venta")

' Relaciones a Base de Datos
Rel(sale_order, db, "Persiste datos vía ORM")
Rel(sale_order_line, db, "Persiste datos vía ORM")
Rel(stock_picking, db, "Persiste datos vía ORM")

@enduml