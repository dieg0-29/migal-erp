@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_TOP_DOWN()
title Diagrama de Componentes (Nivel 3) - CRM

Person(prop, "Propietarios (R-PRO)", "Deciden descuento excepcional, promesa y condición de comprobante")
Person(trab, "Trabajadores (R-ATN)", "Registra lead, interacción y próxima acción")
System_Ext(whatsapp, "WhatsApp / Teléfono / Presencial", "Canal")

Container_Boundary(crm_app, "CRM (crm + utm + contacts)") {
    Component(partner, "res.partner", "Modelo ORM", "Cuenta (cliente/obra) y contactos con rol: dueño de obra, maestro, receptor; dirección de obra")
    Component(utm, "utm.campaign / utm.source / utm.medium", "Modelos ORM", "Campaña (p.ej. volanteo [S]), fuente (referido maestro), medio (WhatsApp)")
    Component(lead, "crm.lead", "Modelo ORM", "Lead y oportunidad: necesidad, probabilidad, competidor (etiqueta/nota), responsable")
    Component(stage, "crm.stage", "Modelo ORM", "Nuevo → Calificado → Propuesta → Ganado / Perdido")
    Component(activity, "mail.activity + chatter", "Modelos ORM", "Interacciones, próxima acción y registro de decisiones")
    Component(lost, "crm.lost.reason", "Modelo ORM", "Motivo de no adjudicación: precio de competencia, flete, crédito, sin respuesta")
}

Container_Boundary(sale_app, "Ventas (sale + sale_crm)") {
    Component(quote, "sale.order (estado borrador / enviado)", "Modelo ORM", "Cotización: líneas, precio, descuento, criterio de vigencia y comprobante previsto")
    Component(pricelist, "product.pricelist", "Modelo ORM", "Precio de referencia; descuento visible por línea")
    Component(confirm, "action_confirm()", "Método", "FRONTERA CRM a ERP (INT-01, F-02): convierte la cotización aceptada en pedido")
}
Container(stock, "Inventario (stock.quant)", "Módulo stock", "Consulta de disponibilidad por almacén")

Rel(whatsapp, trab, "1. Llega consulta / lista")
Rel(trab, lead, "2. Registra lead")
Rel(lead, utm, "Origen")
Rel(lead, partner, "3. Vincula cuenta y contacto")
Rel(lead, stage, "4. Califica → oportunidad")
Rel(trab, activity, "Registra interacción y próxima acción")
Rel(lead, quote, "5. Nueva cotización")
Rel(quote, pricelist, "Toma precio de referencia")
Rel(quote, stock, "Consulta disponibilidad (sin reservar)")
Rel(prop, quote, "6. Decide descuento, promesa y comprobante")
Rel(prop, activity, "Deja evidencia de la decisión")
Rel(quote, confirm, "7. Aceptación del cliente")
Rel(lead, lost, "Si no se adjudica")
@enduml
