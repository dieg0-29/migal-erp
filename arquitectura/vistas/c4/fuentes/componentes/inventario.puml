@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Diagrama de Componentes (Nivel 3) - Gestión de Inventario

Person(alm, "Personal de almacén (R-ALM)", "Registra recepciones, despachos, transferencias y conteos")
Person(prop, "Propietarios (R-PRO)", "Autorizan ajustes y deciden ante faltantes (SOD-03)")

Container(sales_mod, "Ventas", "Módulo sale", "Pedidos confirmados")
Container(pos_mod, "Punto de Venta", "Módulo point_of_sale", "Ventas de mostrador en la Tienda")
Container(acc_mod, "Contabilidad básica", "Módulo de la comunidad (ADR-003)", "Valoración del inventario por validar (CA-07)")

Container_Boundary(inv_app, "Inventario (stock)") {
    Component(stock_picking, "stock.picking", "Modelo ORM", "Recepciones, entregas, transferencias y ajustes")
    Component(stock_move, "stock.move", "Modelo ORM", "Líneas de cada movimiento")
    Component(stock_quant, "stock.quant", "Modelo ORM", "Existencias por ubicación: Tienda, Almacén 1 y Almacén 2")
}

ContainerDb(db, "Base de datos", "PostgreSQL", "Historial de movimientos")

Rel(alm, stock_picking, "1. Registra recepción con cantidad real (RN-19)", "Navegador")
Rel(alm, stock_picking, "2. Prepara y valida entregas y transferencias (RN-10)", "Navegador")
Rel(alm, stock_quant, "3. Cuenta y reporta diferencias", "Navegador")
Rel(prop, stock_picking, "4. Autoriza el ajuste (RN-21, SOD-03)", "Navegador")
Rel(sales_mod, stock_picking, "Entrega generada al confirmar el pedido")
Rel(pos_mod, stock_picking, "Salida automática e inmediata por cada venta")
Rel(stock_picking, stock_move, "Detalla")
Rel(stock_move, stock_quant, "Actualiza existencias por ubicación")
Rel(stock_move, acc_mod, "Valoración (por validar)")
Rel(stock_quant, db, "Persiste")
@enduml
